  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AntennaGuardian.App\AntennaGuardian.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\src\AntennaGuardian.App\App.xaml"
          Link="Xaml\App.xaml"
