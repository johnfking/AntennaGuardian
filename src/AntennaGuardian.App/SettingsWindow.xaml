<Window x:Class="AntennaGuardian.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AntennaGuardian Settings"
        Width="760"
        Height="640"
        MinWidth="660"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="Segoe UI"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <Style x:Key="BandToggle" TargetType="ToggleButton">
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Foreground" Value="#AEB6C0" />
            <Setter Property="Background" Value="#171B22" />
            <Setter Property="BorderBrush" Value="#343A45" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Cascadia Mono" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ToggleSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleSurface" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#07150D" />
                                <Setter Property="Background" Value="{StaticResource GreenBrush}" />
                                <Setter Property="BorderBrush" Value="#74DA93" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ToggleSurface" Property="Background" Value="#6FD590" />
                            </MultiTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ToggleSurface" Property="BorderBrush" Value="#F0C45B" />
                                <Setter TargetName="ToggleSurface" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ItemsPanelTemplate x:Key="BandTogglePanel">
            <UniformGrid Rows="1" />
        </ItemsPanelTemplate>
        <DataTemplate x:Key="Ant1BandToggleTemplate">
            <ToggleButton Content="{Binding Label}"
                          IsChecked="{Binding Ant1Allowed}"
                          Style="{StaticResource BandToggle}"
                          ToolTip="{Binding Name, StringFormat=Allow ANT1 on {0}}" />
        </DataTemplate>
        <DataTemplate x:Key="Ant2BandToggleTemplate">
            <ToggleButton Content="{Binding Label}"
                          IsChecked="{Binding Ant2Allowed}"
                          Style="{StaticResource BandToggle}"
                          ToolTip="{Binding Name, StringFormat=Allow ANT2 on {0}}" />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
            <RowDefinition Height="56" />
        </Grid.RowDefinitions>

        <Border Background="#151820" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xEA18;"
                           FontFamily="Segoe Fluent Icons"
                           FontSize="19"
                           Foreground="{StaticResource GoldBrush}"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="AntennaGuardian"
                               FontSize="15"
                               FontWeight="SemiBold" />
                    <TextBlock Text="RADIO INTERLOCK"
                               Margin="0,1,0,0"
                               FontSize="9"
                               FontWeight="Bold"
                               Foreground="{StaticResource GoldBrush}" />
                </StackPanel>
                <Border Grid.Column="2"
                        Padding="9,4"
                        Background="#1B1F27"
                        BorderBrush="#66562B"
                        BorderThickness="1"
                        CornerRadius="4"
                        VerticalAlignment="Center">
                    <TextBlock Text="POLICY CONTROL"
                               FontSize="9"
                               FontWeight="Bold"
                               Foreground="{StaticResource GoldBrush}" />
                </Border>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="18,8,18,0">
            <TabItem Header="Policy">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,12,4,8">
                        <TextBlock Text="RADIO"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource GoldBrush}" />
                        <Grid Margin="0,7,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Address"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedBrush}" />
                            <TextBox x:Name="RadioHostTextBox"
                                     Grid.Column="1"
                                     Height="34"
                                     Padding="9,5"
                                     VerticalContentAlignment="Center"
                                     FontFamily="Cascadia Mono"
                                     FontSize="13" />
                        </Grid>

                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" />
                        <TextBlock Text="PROTECTION"
                                   Margin="0,16,0,8"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource GoldBrush}" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Radio interlock"
                                           FontSize="13"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Flex Ethernet antenna interlock"
                                           Margin="0,2,0,0"
                                           FontSize="11"
                                           Foreground="{StaticResource MutedBrush}" />
                            </StackPanel>
                            <ToggleButton x:Name="ProtectionCheckBox"
                                          Grid.Column="1"
                                          Style="{StaticResource ProtectionToggle}"
                                          VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="ANTENNA / BAND MATRIX"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource GoldBrush}" />
                        <Border Margin="0,7,0,12"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <StackPanel Margin="8">
                                <Grid Height="40">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="142" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="ANT1"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource MutedBrush}" />
                                        <TextBox x:Name="Ant1NameTextBox"
                                                 Grid.Column="1"
                                                 Height="30"
                                                 Margin="2"
                                                 Padding="8,3"
                                                 MaxLength="24"
                                                 VerticalContentAlignment="Center"
                                                 FontSize="11"
                                                 ToolTip="Display name for Flex antenna ANT1" />
                                    </Grid>
                                    <ItemsControl Grid.Column="1"
                                                  ItemsSource="{Binding Bands}"
                                                  ItemsPanel="{StaticResource BandTogglePanel}"
                                                  ItemTemplate="{StaticResource Ant1BandToggleTemplate}" />
                                </Grid>
                                <Grid Height="40">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="142" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="ANT2"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource MutedBrush}" />
                                        <TextBox x:Name="Ant2NameTextBox"
                                                 Grid.Column="1"
                                                 Height="30"
                                                 Margin="2"
                                                 Padding="8,3"
                                                 MaxLength="24"
                                                 VerticalContentAlignment="Center"
                                                 FontSize="11"
                                                 ToolTip="Display name for Flex antenna ANT2" />
                                    </Grid>
                                    <ItemsControl Grid.Column="1"
                                                  ItemsSource="{Binding Bands}"
                                                  ItemsPanel="{StaticResource BandTogglePanel}"
                                                  ItemTemplate="{StaticResource Ant2BandToggleTemplate}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="OVERLAY"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource GoldBrush}" />
                        <Grid Margin="0,7,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Opacity" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                            <Slider x:Name="OpacitySlider"
                                    Grid.Column="1"
                                    Minimum="0.55"
                                    Maximum="1"
                                    TickFrequency="0.05"
                                    IsSnapToTickEnabled="True" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="110,5,0,2">
                            <CheckBox x:Name="AlwaysOnTopCheckBox" Content="Always on top" Margin="0,0,28,0" />
                            <CheckBox x:Name="ClickThroughCheckBox" Content="Click-through mode" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Activity">
                <Border Margin="4,16,4,16"
                        Background="#101319"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <ListBox ItemsSource="{Binding Activity}"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="#C8D0D5"
                             FontFamily="Cascadia Mono"
                             FontSize="11"
                             Padding="10"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                </Border>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2"
                Background="#151820"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="18,0">
                <Button Content="Cancel"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0"
                        Click="CancelButton_Click" />
                <Button Content="Save policy"
                        Style="{StaticResource PrimaryButton}"
                        Click="SaveButton_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
