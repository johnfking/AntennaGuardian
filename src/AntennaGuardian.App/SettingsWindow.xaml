<Window x:Class="AntennaGuardian.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AntennaGuardian Settings"
        Width="760"
        Height="720"
        MinWidth="660"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="Segoe UI"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <DataTemplate x:Key="BandRowTemplate">
            <Border BorderBrush="#2B3039" BorderThickness="0,1,0,0">
                <Grid Height="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="52" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}"
                               Margin="12,0"
                               VerticalAlignment="Center"
                               FontFamily="Cascadia Mono"
                               FontSize="12"
                               FontWeight="SemiBold" />
                    <CheckBox Grid.Column="1"
                              IsChecked="{Binding Ant1Allowed}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    <CheckBox Grid.Column="2"
                              IsChecked="{Binding Ant2Allowed}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
            <RowDefinition Height="56" />
        </Grid.RowDefinitions>

        <Border Background="#151820" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xEA18;"
                           FontFamily="Segoe Fluent Icons"
                           FontSize="19"
                           Foreground="{StaticResource GoldBrush}"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="AntennaGuardian"
                               FontSize="15"
                               FontWeight="SemiBold" />
                    <TextBlock Text="RADIO INTERLOCK"
                               Margin="0,1,0,0"
                               FontSize="9"
                               FontWeight="Bold"
                               Foreground="{StaticResource GoldBrush}" />
                </StackPanel>
                <Border Grid.Column="2"
                        Padding="9,4"
                        Background="#1B1F27"
                        BorderBrush="#66562B"
                        BorderThickness="1"
                        CornerRadius="4"
                        VerticalAlignment="Center">
                    <TextBlock Text="POLICY CONTROL"
                               FontSize="9"
                               FontWeight="Bold"
                               Foreground="{StaticResource GoldBrush}" />
                </Border>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="18,8,18,0">
            <TabItem Header="Policy">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,12,4,8">
                        <TextBlock Text="RADIO"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource GoldBrush}" />
                        <Grid Margin="0,7,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Address"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedBrush}" />
                            <TextBox x:Name="RadioHostTextBox"
                                     Grid.Column="1"
                                     Height="34"
                                     Padding="9,5"
                                     VerticalContentAlignment="Center"
                                     FontFamily="Cascadia Mono"
                                     FontSize="13" />
                        </Grid>

                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" />
                        <TextBlock Text="PROTECTION"
                                   Margin="0,16,0,8"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource GoldBrush}" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Radio interlock"
                                           FontSize="13"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Flex Ethernet antenna interlock"
                                           Margin="0,2,0,0"
                                           FontSize="11"
                                           Foreground="{StaticResource MutedBrush}" />
                            </StackPanel>
                            <ToggleButton x:Name="ProtectionCheckBox"
                                          Grid.Column="1"
                                          Style="{StaticResource ProtectionToggle}"
                                          VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="ANTENNA / BAND MATRIX"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource GoldBrush}" />
                        <Border Margin="0,7,0,12"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <Grid Height="34" Background="#20252E">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="52" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Band" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="ANT1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                        <TextBlock Grid.Column="2" Text="ANT2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding LeftBands}" ItemTemplate="{StaticResource BandRowTemplate}" />
                                </StackPanel>

                                <Border Grid.Column="1" Background="{StaticResource LineBrush}" />

                                <StackPanel Grid.Column="2">
                                    <Grid Height="34" Background="#20252E">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="52" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Band" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="ANT1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                        <TextBlock Grid.Column="2" Text="ANT2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding RightBands}" ItemTemplate="{StaticResource BandRowTemplate}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Text="OVERLAY"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource GoldBrush}" />
                        <Grid Margin="0,7,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Opacity" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                            <Slider x:Name="OpacitySlider"
                                    Grid.Column="1"
                                    Minimum="0.55"
                                    Maximum="1"
                                    TickFrequency="0.05"
                                    IsSnapToTickEnabled="True" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="110,5,0,2">
                            <CheckBox x:Name="AlwaysOnTopCheckBox" Content="Always on top" Margin="0,0,28,0" />
                            <CheckBox x:Name="ClickThroughCheckBox" Content="Click-through mode" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Activity">
                <Border Margin="4,16,4,16"
                        Background="#101319"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <ListBox ItemsSource="{Binding Activity}"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="#C8D0D5"
                             FontFamily="Cascadia Mono"
                             FontSize="11"
                             Padding="10"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                </Border>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2"
                Background="#151820"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="18,0">
                <Button Content="Cancel"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0"
                        Click="CancelButton_Click" />
                <Button Content="Save policy"
                        Style="{StaticResource PrimaryButton}"
                        Click="SaveButton_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
