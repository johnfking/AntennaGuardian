<Window x:Class="AntennaGuardian.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AntennaGuardian"
        Icon="Assets/AntennaGuardian.ico"
        Width="404"
        Height="88"
        MinWidth="360"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown">
    <Border x:Name="Frame"
            CornerRadius="5"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource LineBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.42" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="66" />
            </Grid.ColumnDefinitions>

            <Border x:Name="StateRail"
                    Grid.Column="0"
                    CornerRadius="4,0,0,4"
                    Background="#6F7880" />

            <Grid Grid.Column="1">
                <Ellipse x:Name="ShieldHalo"
                         Width="30"
                         Height="30"
                         Fill="#1B2028"
                         Stroke="#737D87"
                         StrokeThickness="1" />
                <TextBlock x:Name="ShieldIcon"
                           Text="&#xEA18;"
                           FontFamily="Segoe Fluent Icons"
                           FontSize="15"
                           Foreground="#AAB2BA"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Grid>

            <Grid Grid.Column="2" Margin="5,10,5,9">
                <Grid.RowDefinitions>
                    <RowDefinition Height="16" />
                    <RowDefinition Height="27" />
                    <RowDefinition Height="18" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ANTENNA GUARDIAN"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{StaticResource GoldBrush}" />
                    <TextBlock x:Name="VersionText"
                               Margin="6,0,0,0"
                               FontSize="9"
                               Foreground="#727B84" />
                </StackPanel>
                <TextBlock x:Name="StateText"
                           Grid.Row="1"
                           Text="OFFLINE"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="White" />
                <TextBlock x:Name="DetailText"
                           Grid.Row="2"
                           Text="Protection disabled"
                           FontSize="11"
                           Foreground="{StaticResource MutedBrush}"
                           TextTrimming="CharacterEllipsis" />
            </Grid>

            <StackPanel Grid.Column="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,8,7,0">
                <Button Style="{StaticResource IconButton}"
                        Content="&#xE713;"
                        ToolTip="Settings"
                        Click="SettingsButton_Click" />
                <Button Style="{StaticResource IconButton}"
                        Content="&#xE8BB;"
                        ToolTip="Hide overlay"
                        Click="HideButton_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
